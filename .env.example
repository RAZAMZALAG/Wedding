# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=wedding_planner

# MongoDB Connection URIs
DEV_MONGO_URI=mongodb://admin:admin123@localhost:27017/wedding_planner?authSource=admin
PROD_MONGO_URI=mongodb://admin:admin123@mongodb:27017/wedding_planner?authSource=admin

# Application Configuration
CLIENT_PORT=5000
ENV=DEV

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-in-production
FLASK_JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-in-production

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# AI Assistant (Optional)
GEMINI_API_KEY=your-google-gemini-api-key

# Legacy PostgreSQL settings (remove after migration)
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=wedding_planner
# POSTGRES_PORT=5432
# DEV_DB_URI=postgresql://user:password@localhost:5432/wedding_planner
